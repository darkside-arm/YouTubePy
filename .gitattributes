# Auto detect text files and perform LF normalization
* text=auto

# El launcher y cualquier script se ejecutan en la consola (Linux): con
# finales de linea CRLF, bash falla con "$'\r': command not found" y el port
# ni siquiera arranca. Se fuerza LF aunque se editen desde Windows.
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
